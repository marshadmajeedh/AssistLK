# Copy required values to your local .env file.
# NEVER commit real secret values or connection strings.

# ================================================================
# ASP.NET Core Backend Configuration
# ================================================================

# Supabase / PostgreSQL connection
ConnectionStrings__DefaultConnection=

# JWT signing secret
Jwt__Key=

# Runtime environment
ASPNETCORE_ENVIRONMENT=Development


# ================================================================
# Component 1 - Problem Understanding Agent
# ASP.NET Core -> Internal Python Agent Service
# ================================================================

# Which C1 agent implementation ASP.NET should use:
# NativeCSharp | ExternalPython
AgentServices__ProblemUnderstandingMode=ExternalPython

# Internal Python FastAPI service
AgentServices__ProblemUnderstandingUrl=http://127.0.0.1:8001

# Optional shared secret between ASP.NET and Python.
# For local development this may be empty.
# If set here, the SAME value must be used as INTERNAL_API_KEY
# in the Python agent .env.
AgentServices__InternalApiKey=

# Internal HTTP timeout
AgentServices__TimeoutSeconds=45


# ================================================================
# Legacy Native C# Gemini Agent
# ================================================================

# Only required when using:
# AgentServices__ProblemUnderstandingMode=NativeCSharp
#
# Can remain configured while the native C# agent is preserved.
GOOGLE_API_KEY=


# ================================================================
# Cross-Project / Client Variables
# ================================================================

DATABASE_URL=
JWT_SECRET=
MAPS_API_KEY=
AI_API_KEY=

# Legacy/general external-agent variable.
# Do not use this for C1 if the backend now reads
# AgentServices__ProblemUnderstandingUrl.
AGENT_SERVICE_URL=