# Copy required values to your local .env file.
# NEVER commit real secret values or connection strings.

# ================================================================
# ASP.NET Core Backend Configuration
# ================================================================

# Supabase Session Pooler connection string (Port 5432, SSL required)
# Format: Host=<pooler-host>;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;
ConnectionStrings__DefaultConnection=

# JWT Secret Key (required by Program.cs Jwt:Key)
Jwt__Key=

# Google Gemini API Key (read by GeminiService)
GOOGLE_API_KEY=

# Runtime Environment
ASPNETCORE_ENVIRONMENT=Development

# ================================================================
# Cross-Project / Client / External Service Variables
# ================================================================
DATABASE_URL=
JWT_SECRET=
MAPS_API_KEY=
AI_API_KEY=
AGENT_SERVICE_URL=
