# ================================================================
# AssistLK Component 1 - Problem Understanding Agent Configuration
# Copy this file to .env and configure appropriate values.
# NEVER commit real secret values to source control.
# ================================================================

# Service Settings
SERVICE_NAME=problem-understanding-agent
HOST=127.0.0.1
PORT=8001
ENVIRONMENT=development

# Active LLM Provider: "gemini" | "openai" | "offline"
LLM_PROVIDER=gemini

# Google Gemini Configuration (Verified model: gemini-3.6-flash)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI Configuration (Alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Resilience & Timeouts (Python owns LLM retry behavior)
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_ATTEMPTS=2

# Test & Fallback Settings
ALLOW_OFFLINE_SIMULATION=true

# Internal Service-to-Service Authentication (Empty = open in local dev)
INTERNAL_API_KEY=
